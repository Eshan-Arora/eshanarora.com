---
interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={['inline-flex items-center gap-1.5 no-underline', className]}
>
	<slot name="icon" />
	<span class="underline decoration-[color:var(--accent)] underline-offset-2">
		<slot />
	</span>
	<svg
		class="h-3.5 w-3.5 shrink-0 text-[color:rgb(var(--gray))]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<line x1="7" y1="17" x2="17" y2="7"></line>
		<polyline points="7 7 17 7 17 17"></polyline>
	</svg>
	<span class="sr-only">(opens in a new tab)</span>
</a>
